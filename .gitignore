# Contains ROSA_TOKEN and your AWS profile name. Never commit.
.env

# Written by scripts/02-cluster.sh
.cluster-state

# enterprise/setup.sh copies app/src/custom_nodes/ in here at build time so
# both images carry the same nodes. The canonical copy is app/src/custom_nodes;
# committing the duplicates would just let the two drift.
enterprise/worker/custom_nodes/*
!enterprise/worker/custom_nodes/README.md

# Local model files, if you stage them here before rsync
models/
checkpoints/
*.safetensors
*.ckpt
*.pt

# Editor / OS
.DS_Store
*.swp
__pycache__/
*.pyc

# A redis-server started in the repo root (a test run, a local experiment)
# writes its snapshot here; it is never a source file.
dump.rdb
*.rdb
appendonly.aof
