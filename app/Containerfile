# ComfyUI image that actually runs under OpenShift's restricted-v2 SCC.
#
# The whole trick is the last third of this file. OpenShift will run this
# container as an arbitrary UID it picks at admission time — not 1000, not the
# USER below — with GID 0 as a supplementary group. So every path the process
# writes to has to be group-writable and owned by root group. Images that work
# under `podman run` and crash-loop on OpenShift almost always fail on exactly
# this.
#
#   podman build -t comfyui:latest -f app/Containerfile app/
#
# Or let the cluster build it: leave COMFYUI_IMAGE empty in .env and
# `make deploy` will create a BuildConfig from this file.

# The -base- variant, not -cudnn-runtime-. The torch wheels pip installs below
# vendor their own cuDNN/cuBLAS (the nvidia-*-cu12 packages) and load those, so
# the cudnn-runtime image ships ~1.5-2 GB of libraries nothing uses — which on
# a node that pulls this image cold is minutes of startup for zero benefit.
FROM nvcr.io/nvidia/cuda:12.6.2-base-ubi9

# Kept in sync with COMFYUI_REF in .env.example; scripts/05-deploy.sh passes
# the .env value through as a build arg. Pinned here too so a local
# `podman build` with no args builds the same thing the cluster does.
#
# TORCH_VERSION/TORCHVISION_VERSION/TORCHAUDIO_VERSION are one set —
# torchvision and torchaudio each build against a single torch release, so
# bumping one alone breaks at import, not at build.
#
# 2.8.0 is not a preference, it is the line below which COMFYUI_REF quietly
# degrades. ComfyUI v0.32.0 enables DynamicVRAM by default on NVIDIA and
# nothing in the CMD at the bottom of this file opts out (enables_dynamic_vram
# in comfy/cli_args.py); main.py then gates it at torch >= 2.8, and below that
# logs "Unsupported Pytorch detected" and falls back to the legacy
# ModelPatcher. cu128 is the lowest index carrying 2.8 — cu124 stops at 2.6.0
# and never got a 2.7+ wheel — which is why the index moved with the pin.
#
# Note the failure mode that justifies pinning at all: it is silence, not a
# crash. Unpinned on cu124 pip resolved 2.6.0, ComfyUI booted fine, and the
# whole symptom was one log line. Bump all four together, and re-read ComfyUI's
# version gates when you do — the floor belongs to COMFYUI_REF, not to torch.
ARG COMFYUI_REF=v0.32.0
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu128
ARG TORCH_VERSION=2.8.0
ARG TORCHVISION_VERSION=0.23.0
ARG TORCHAUDIO_VERSION=2.8.0
ARG MANAGER_REF=4.2.2

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_ROOT=/opt/comfyui

# ---------------------------------------------------------------------------
# System packages
#
# git is needed to fetch ComfyUI and custom nodes at build time. mesa-libGL and
# libglib are pulled in by opencv, which half the custom node ecosystem depends
# on and which fails at import time without them.
# ---------------------------------------------------------------------------

RUN dnf install -y --setopt=install_weak_deps=False \
        python3.11 python3.11-pip python3.11-devel \
        git mesa-libGL glib2 \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# ---------------------------------------------------------------------------
# ComfyUI and PyTorch
#
# Torch is installed first and separately so it lands in its own layer — it is
# ~2.5 GB and you do not want to re-pull it every time a requirement changes.
# ---------------------------------------------------------------------------

WORKDIR ${APP_ROOT}

RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install --index-url ${TORCH_INDEX} \
        torch==${TORCH_VERSION} \
        torchvision==${TORCHVISION_VERSION} \
        torchaudio==${TORCHAUDIO_VERSION}

RUN git clone --depth 1 --branch ${COMFYUI_REF} \
        https://github.com/comfyanonymous/ComfyUI.git . \
    && python3 -m pip install -r requirements.txt

# ---------------------------------------------------------------------------
# ComfyUI-Manager (ENABLE_MANAGER=true in .env, then `make deploy` to rebuild)
#
# Its headline feature here: load a workflow, Manager lists every model the
# workflow needs that you do not have, and one click downloads them — into
# /models, the persistent volume, where ComfyUI actually reads them (that is
# the --models-directory flag at the bottom of this file doing its job).
#
# It lives in custom_nodes/ inside the ComfyUI install, like any other node
# pack — before the permissions section below, so the arbitrary UID can write
# its config and cache.
#
# Know the limits: model downloads persist; runtime custom-NODE installs do
# not (container filesystem, gone on restart, and their pip deps cannot
# install into read-only site-packages at all — bake nodes into src/ instead).
# And keep this pod behind `make forward`: Manager is an install-and-run-code
# button, which is fine for you and catastrophic on a public Route.
# ---------------------------------------------------------------------------

ARG ENABLE_MANAGER=false

# Pinned to MANAGER_REF (declared above, alongside COMFYUI_REF) — an
# unpinned clone here means "install nodes and download models" behavior
# can change on a rebuild with nobody touching this file. ltdrdata/ moved to
# Comfy-Org/ upstream; the old URL still redirects, but point at the current
# one so a redirect going away later doesn't silently break builds.
RUN if [ "$ENABLE_MANAGER" = "true" ]; then \
        git clone --depth 1 --branch ${MANAGER_REF} \
            https://github.com/Comfy-Org/ComfyUI-Manager.git \
            custom_nodes/ComfyUI-Manager && \
        python3 -m pip install -r custom_nodes/ComfyUI-Manager/requirements.txt; \
    fi

# ---------------------------------------------------------------------------
# Your code
#
# Drop custom nodes, workflows, and any backend of your own into app/src/ and
# they land here. Keep pip installs at BUILD time — the container cannot install
# anything at start, it has no network guarantees and no write access outside
# the volumes.
# ---------------------------------------------------------------------------

COPY requirements-extra.txt ${APP_ROOT}/requirements-extra.txt
COPY src/ ${APP_ROOT}/

RUN if [ -s ${APP_ROOT}/requirements-extra.txt ]; then \
        python3 -m pip install -r ${APP_ROOT}/requirements-extra.txt; \
    fi

# ---------------------------------------------------------------------------
# OpenShift arbitrary-UID compatibility
#
# Everything below this line is what makes the image portable to OpenShift.
# Removing any of it will produce a permission error at start that looks like a
# volume problem and is not.
# ---------------------------------------------------------------------------

# Model and output dirs are mount points for PVCs. They must exist and be
# group-writable so the arbitrary UID can write through the mount. user/ is
# ComfyUI's own — settings, logs and saved workflows land there on first boot —
# and creating it here rather than letting ComfyUI create it is what lets the
# permissions below name it explicitly.
RUN mkdir -p /models /output \
        ${APP_ROOT}/temp ${APP_ROOT}/input ${APP_ROOT}/user

# Group root EVERYWHERE, group-writable only where the process actually writes.
#
# The chmod used to be recursive over ${APP_ROOT} entire, which handed the
# running container write access to main.py, comfy/ and every node beside them.
# GID 0 is a supplementary group of whatever UID OpenShift picks, so g+w on the
# whole tree means anything that can run Python in this container can rewrite
# the application it is running inside, and the rewrite survives every restart
# of that container. Nothing needs it: ComfyUI reads its own source and writes
# only the paths named below.
#
# ${APP_ROOT} ITSELF stays group-writable, one level, and that is not an
# oversight — ComfyUI creates directories directly under its base directory at
# boot, and a read-only parent turns that into a permission error at start.
# custom_nodes is in the writable set because ComfyUI-Manager writes its config
# and cache there, which the Manager section above promises it can.
#
# The setgid bit on directories is the other half: files created later inherit
# GID 0 rather than the creating process's group.
RUN chgrp -R 0 ${APP_ROOT} /models /output \
    && chmod g=u,g+s ${APP_ROOT} \
    && chmod -R g=u ${APP_ROOT}/temp ${APP_ROOT}/input ${APP_ROOT}/user \
                    ${APP_ROOT}/custom_nodes /models /output \
    && find ${APP_ROOT}/temp ${APP_ROOT}/input ${APP_ROOT}/user \
            ${APP_ROOT}/custom_nodes /models /output \
            -type d -exec chmod g+s {} \;

# Declared for local `podman run` clarity. OpenShift overrides it, which is
# fine — the permissions above are what make that safe.
USER 1001

EXPOSE 8188

# ComfyUI resolves model dirs relative to its own tree by default, so point it
# at the volumes explicitly. --listen 0.0.0.0 is required for the readiness
# probe to reach it from the kubelet.
#
# --models-directory, NOT --base-directory. --base-directory relocates the
# whole tree: models would be looked up under /models/models/... and — worse —
# custom_nodes under /models/custom_nodes, so every node baked into this image
# would silently never load. --models-directory moves only the model search
# path, which is the thing the volume actually holds.
ENTRYPOINT ["python3", "main.py"]
CMD ["--listen", "0.0.0.0", \
     "--port", "8188", \
     "--models-directory", "/models", \
     "--output-directory", "/output", \
     "--temp-directory", "/tmp"]
