# Copy to .env and edit. Every script reads this — it is the only place you
# should need to configure anything.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Where the cluster lives
# ---------------------------------------------------------------------------

# rosa       = create and manage a ROSA HCP cluster with these scripts
# openshift  = you already have a cluster (SNO, self-managed OCP, CRC, whatever);
#              scripts skip cluster creation and just do GPU + storage + deploy
PLATFORM=rosa

AWS_PROFILE=rosa-admin
AWS_REGION=us-east-2
CLUSTER_NAME=comfy

# From https://console.redhat.com/openshift/token/rosa
ROSA_TOKEN=

# ---------------------------------------------------------------------------
# Machines
# ---------------------------------------------------------------------------

# Base pool carries OpenShift's own workloads. 2 is the ROSA HCP minimum.
BASE_INSTANCE_TYPE=m5.xlarge
BASE_REPLICAS=2

# GPU pool. Two different memories, and mixing them up is a real bug this repo
# has already shipped once: VRAM is the card's and holds the model, host RAM is
# the node's and is what the worker pod's memory request comes out of. The
# resources comment in enterprise/manifests/02-worker.yaml does that arithmetic.
#              card  VRAM   host RAM  $/hr
#   g6.xlarge  L4    24 GB  16 GiB    ~0.80   default; fits SDXL + refiner + ControlNets
#   g5.xlarge  A10G  24 GB  16 GiB    ~1.01   faster fp16, older gen, different capacity pool
#   g6e.xlarge L40S  48 GB  32 GiB    ~1.86   only if you need FLUX or video models
GPU_INSTANCE_TYPE=g6.xlarge
GPU_REPLICAS=1

# ---------------------------------------------------------------------------
# Storage  (see docs/03-storage.md — this is the part that bites people)
# ---------------------------------------------------------------------------

# rwo = one gp3 block volume bound to one node. Fast, cheap, simple.
#       Correct answer for a single ComfyUI pod, which is what one GPU supports.
# rwx = EFS, shared across pods and nodes. Only needed if you run more than one
#       replica or want to write models from a separate job. Slower model loads,
#       and needs an IAM role — the script handles it, but it is more moving parts.
STORAGE_MODE=rwo

MODELS_SIZE=100Gi
OUTPUT_SIZE=20Gi

# Optional: S3 as the canonical model store, so models survive 'make down',
# 'make destroy', and the cluster itself (~$0.023/GB-month). Create the
# bucket + IAM role + ServiceAccount once with scripts/09-s3-models.sh, set
# the bucket name here, and 'make deploy' adds an init container that syncs
# it into /models on every pod start. See docs/03-storage.md.
MODELS_S3_BUCKET=

# ---------------------------------------------------------------------------
# Workload
# ---------------------------------------------------------------------------

APP_NAMESPACE=comfyui

# Leave empty to build from app/Containerfile in-cluster via a BuildConfig.
# Set it to point at an image you already have, e.g.
#   quay.io/you/comfyui:latest
COMFYUI_IMAGE=

# ComfyUI commit to build, for both the single-user and multi-user images.
# A commit rather than the tag because a tag can be moved upstream and a
# commit cannot; this one is v0.32.0. A tag or branch name also works here.
COMFYUI_REF=c2bcbecd82ec5ae66594340b395c24ef0217b238

# Torch build args, one set — torchvision and torchaudio each build against a
# single torch release, so bumping one alone breaks at import, not at build.
# Kept in sync with the ARG defaults in app/Containerfile; scripts/05-deploy.sh
# passes these through as build args, the same way it does COMFYUI_REF. See
# that file's comment above ARG COMFYUI_REF before bumping any of the four —
# ComfyUI's own version gates are what actually require torch >= 2.8.
TORCH_INDEX=https://download.pytorch.org/whl/cu128
TORCH_VERSION=2.8.0
TORCHVISION_VERSION=0.23.0
TORCHAUDIO_VERSION=2.8.0

# Bake ComfyUI-Manager into the image (both configurations; rebuild to apply).
# No MANAGER_REF knob: Manager is installed as the pip package ComfyUI itself
# pins (manager_requirements.txt at COMFYUI_REF), so its version moves with
# the COMFYUI_REF SHA above.
#
# What it buys you: load a workflow, Manager lists every model the workflow
# needs that you do not have, and one click downloads them into /models — the
# persistent volume — so they survive restarts and redeploys.
#
# Single user behind 'make forward': a reasonable convenience.
# Multi user: think first — Manager lets ANY user with UI access install and
# run arbitrary Python on a GPU node holding cloud credentials, and node
# installs do not survive scale-to-zero anyway. docs/06 has the argument.
#
# Either way, custom NODES belong in app/src/custom_nodes/, baked at build
# time: runtime node installs vanish on pod restart, and their pip
# dependencies cannot install at runtime at all.
ENABLE_MANAGER=false

# ---------------------------------------------------------------------------
# Multi-user configuration  (enterprise/ — ignored by the single-user path)
#
# See enterprise/README.md for setup and docs/06-enterprise-architecture.md for
# why it is shaped the way it is.
# ---------------------------------------------------------------------------

# oauth = behind the cluster's identity provider; access granted with an
#         OpenShift role in the namespace.
# none  = public with no login. The GPU pods stay unreachable either way, but
#         anyone with the URL can spend your GPU budget.
AUTH_MODE=oauth

# Ceiling for both autoscalers — KEDA's pod count and the GPU machine pool.
MAX_GPU_WORKERS=3

# VRAM tiers — pools per card class, so nobody pays 80 GB prices for a 24 GB
# job (docs/10-roadmap.md, N2). Ordered, comma-separated, SMALLEST CARD
# FIRST: the first name is the default tier — where a submission that names
# no tier lands — and it rides the existing 'gpu' machine pool, the plain
# comfy:queue and the comfy-worker Deployment unchanged. Every later name
# gets its own machine pool (gpu-<tier>), its own worker Deployment and its
# own KEDA ScaledObject watching its own queue (comfy:queue:<tier>), so an
# l40s backlog buys l40s nodes and nothing else. A job asks for a tier by
# adding it to the submission: {"workflow": {...}, "tier": "l40s"} — an
# unknown tier is refused with a 400 naming the valid ones.
#
# Empty (the default) is tiering off: one queue, one pool, exactly the
# pre-N2 behaviour. Names are lowercase letters, digits and '-' — they
# become Redis keys, metric labels and machine pool names, and both setup.sh
# and the gateway refuse anything else loudly.
#
# For each tier AFTER the first, name its instance type (and optionally its
# own worker ceiling) by suffix — uppercase, '-' becomes '_':
#
#   GPU_TIERS=l4,l40s
#   GPU_INSTANCE_TYPE_L40S=g6e.xlarge     # required per extra tier, or its
#                                         # machine pool is skipped with a
#                                         # warning and its jobs just queue
#   MAX_GPU_WORKERS_L40S=2                # optional; default MAX_GPU_WORKERS
#
# The default tier keeps using GPU_INSTANCE_TYPE above. Real tier pools
# autoscaling is a cluster-day item (docs/12-first-cluster-day.md); the
# routing itself is proven on a laptop by enterprise/test/
# check-58-tier-routing.py.
GPU_TIERS=

# true  = KEDA scales worker pods 0..MAX on queue depth, and the GPU machine
#         pool scales its nodes to zero with them. Saves ~$0.98/hr when idle,
#         at the cost of an 8-17 minute cold start on the first job.
# false = one warm worker, all day, every day. Right for interactive iteration,
#         where a cold start lands in the middle of someone's creative loop.
#         Note that this path skips KEDA entirely — the ScaledObject, the
#         machine-pool autoscaling and WARM_WORKERS below all do nothing.
SCALE_TO_ZERO=true

# The scheduled warm floor: hold this many workers during working hours, and
# scale to zero outside them. The middle setting between the two above —
# nobody waits out a cold start at nine in the morning, and nobody pays for a
# card overnight or at the weekend.
#
# 0 is off, and off is the default, because this is the setting in this file
# that spends money while nobody is watching. One g6.xlarge held 09:00-18:00 on
# weekdays is ~195 hours a month at ~$0.80 — about $155 — on top of whatever
# the queue itself provokes. Two is twice that. Decide with docs/02-cost.md
# open, and remember that the floor is a FLOOR: a busy afternoon still scales
# past it, up to MAX_GPU_WORKERS.
#
# KEDA takes the maximum across its triggers, so the queue-depth trigger is
# untouched by this — outside the window it is the only thing deciding, and the
# pool drains as it always did. If WARM_WORKERS is above MAX_GPU_WORKERS,
# setup.sh raises the ceiling to meet it and says so.
#
# START and END are cron expressions in TIMEZONE, which is an IANA zone name
# (or UTC). The default window is a UTC working day, which is the wrong working
# day for most people — set the timezone before you set the workers.
#
# The quotes on the two cron expressions are not optional: this file is
# `source`d, so an unquoted `0 9 * * 1-5` is an assignment of 0 followed by an
# attempt to run a command called 9 with the directory listing as its
# arguments.
WARM_WORKERS=0
WARM_START="0 9 * * 1-5"
WARM_END="0 18 * * 1-5"
WARM_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Cost guardrails
# ---------------------------------------------------------------------------

MONTHLY_BUDGET_USD=600
BUDGET_ALERT_EMAIL=

# Per-user GPU-second quota (multi-user gateway only — enterprise/). Once a
# submitter has accrued this many GPU seconds inside the current UTC calendar
# month, the same number 'GET /api/showback' reports for them, their NEW
# submissions are refused with HTTP 429 and a message saying when the quota
# resets. Jobs they already have queued or running are not touched.
#
# 0 = off, and off is the default: a quota nobody chose is a support ticket.
# For a sense of scale, one g6.xlarge hour is 3600 GPU seconds at ~$0.80, so
# QUOTA_GPU_SECONDS=36000 is about ten card-hours (~$8) per person per month.
#
# It is deliberately a LOCAL quota computed from the gateway's own showback
# accounting rather than an AWS budget lookup: the gateway is the public
# attack surface and has no cloud credentials, and AWS Budgets lags real spend
# by hours. It also FAILS OPEN — if that accounting cannot be read the
# submission goes through and the gateway log says loudly that it did, because
# a breaker that trips on an unreachable dependency halts a cluster you are
# already paying for. MONTHLY_BUDGET_USD above remains the backstop.
QUOTA_GPU_SECONDS=0

# What one GPU-hour costs, all-in, for the FOCUS chargeback export
# ('GET /api/showback?format=focus') and as scripts/savings-report.py's
# default. The default is docs/02-cost.md's g6.xlarge figure — $0.805/h to
# AWS plus $0.171/h to Red Hat for its four vCPUs. Change it if your pool
# runs different hardware or a negotiated rate; it prices the export, it
# does not spend anything. A value that does not parse falls back to the
# default with a line in the gateway log, same posture as QUOTA_GPU_SECONDS.
GPU_HOURLY_RATE=0.976

# Who may read every submitter's row of GET /api/showback under
# AUTH_MODE=oauth — comma-separated identities exactly as oauth-proxy reports
# them (usually the OpenShift username). Everyone else gets their own row and
# the pool totals, and never a colleague's name; the list of names was the
# lookup key for other people's output workspaces, so it is not public.
# Ignored under AUTH_MODE=none, where identity is client-supplied anyway.
SHOWBACK_OPERATORS=

# vCPUs of G-family quota to request. g6.xlarge is 4 vCPU each.
GPU_VCPU_REQUEST=32

# ---------------------------------------------------------------------------
# Advanced — every remaining knob the scripts honor, with its default.
# Uncomment only if you know why. Left commented, the defaults apply.
# ---------------------------------------------------------------------------

# BILLING_ACCOUNT_ID=            # ROSA billing account; defaults to the AWS account in use
# VPC_CIDR=10.0.0.0/16           # CIDR for the VPC 02-cluster.sh creates
# VPC_ID=                        # skip VPC discovery in 04-storage.sh (rwx on a BYO cluster)
# NETWORK_STACK_NAME=            # CloudFormation stack name; default ${CLUSTER_NAME}-net
# OPERATOR_ROLE_PREFIX=          # ROSA operator-role prefix; default ${CLUSTER_NAME}
# ACCOUNT_ROLE_PREFIX=           # only used if account-role discovery fails; default ManagedOpenShift
# KEDA_NAMESPACE=openshift-keda  # where the Custom Metrics Autoscaler lives
# GPU_NODE_LABEL=nvidia.com/gpu.present=true   # worker nodeSelector; must be a machine-pool label
# WAIT_TIMEOUT=1800              # seconds 03-gpu-operators.sh waits on operators
# STUCK_MINUTES=5                # how long Terminating counts as stuck in 08-unstick-storage.sh
# INSTALL_DIR=/usr/local/bin     # where 00-tools.sh installs CLIs
